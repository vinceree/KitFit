# ─────────────────────────────────────────────────────────────────────────────
# KitFit — Environment variables
# Copy to `.env.local` for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for deployment.
# Variables prefixed with NEXT_PUBLIC_ are inlined at BUILD time → changing them
# requires a redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Google Gemini API key — used for image generation AND the quality check.
GEMINI_API_KEY=

# Supabase project URL and keys.
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of THIS app. Used in the embed snippet, the demo page,
# Stripe checkout redirects, and as the widget's default apiUrl.
# Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://kitfit-xxxx.vercel.app
NEXT_PUBLIC_APP_URL=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Which AI provider generateTryOn() uses. Default: gemini.
# One of: gemini | nanobanana | wavespeed | replicate_flux
# AI_PROVIDER=gemini

# Gemini prompt assembly style. Default: interleaved. Alternative: block.
# GEMINI_PROMPT_STRUCTURE=interleaved

# ── OPTIONAL — Stripe billing (omit for a demo without payments) ──────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_GROWTH_PRICE_ID=
# STRIPE_PRO_PRICE_ID=

# ── OPTIONAL — alternative AI providers (only if AI_PROVIDER is set to one) ───
# WAVESPEED_API_KEY=
# NANOBANANA_API_KEY=
# REPLICATE_API_TOKEN=
